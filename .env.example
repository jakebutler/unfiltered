# ─────────────────────────────────────────────────────────────────────
# Public app config (also mirrored in wrangler.toml [vars] for Workers)
# ─────────────────────────────────────────────────────────────────────
PUBLIC_APP_URL=http://localhost:3000
ENVIRONMENT=development
AI_GATEWAY_NAME=unfiltered-gateway

# ─────────────────────────────────────────────────────────────────────
# Secrets — for local dev only. In production, set via:
#   wrangler secret put <NAME>
# Values here should match what you paste into Cloudflare for prod.
# ─────────────────────────────────────────────────────────────────────

# WorkOS AuthKit
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=http://localhost:3000/api/auth/callback
WORKOS_COOKIE_PASSWORD=

# LLM providers (all proxied through Cloudflare AI Gateway)
#   OPENROUTER_API_KEY -> Anthropic (Claude) and Google (Gemini)
#   GLM_API_KEY        -> Z.ai (registered as a Custom Provider)
#   OPENAI_API_KEY     -> OpenAI direct (TTS validation)
OPENROUTER_API_KEY=
GLM_API_KEY=
OPENAI_API_KEY=

# Email is sent via Cloudflare Email Service binding (env.EMAIL.send).
# No API key required; the binding is declared in wrangler.toml.
# Set the from-address (must be on a domain you've verified in
# Cloudflare → Email Service):
EMAIL_FROM_ADDRESS=research@yourdomain.com

# Voice runtime (Vapi)
VAPI_PUBLIC_KEY=
VAPI_PRIVATE_KEY=

# Cloudflare AI Gateway (account id, gateway name set in wrangler.toml)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Signed participant URLs
INVITATION_HMAC_SECRET=

# Stripe (Phase 3 — leave blank during validation)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FOUNDER=
STRIPE_PRICE_TEAM=
STRIPE_METER_REAL_SESSIONS=
STRIPE_METER_SYNTHETIC_SESSIONS=
