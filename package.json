{
  "name": "unfiltered",
  "version": "0.2.0",
  "private": true,
  "description": "Always-on AI voice interviewer for honest, multimodal user research.",
  "scripts": {
    "dev": "NEXT_DEV=1 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "wrangler:dev": "wrangler dev",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply unfiltered-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply unfiltered-db --remote",
    "db:studio": "drizzle-kit studio",
    "foundation:build": "tsc -p tsconfig.foundation.json",
    "foundation:typecheck": "tsc -p tsconfig.foundation.json --noEmit",
    "foundation:test": "vitest run --config vitest.foundation.config.mts",
    "qualify": "npm run foundation:build --silent && node .qualification-build/scripts/qualification/cli.js",
    "clinic:dev": "vite apps/clinic --config apps/clinic/vite.config.ts --host 127.0.0.1",
    "clinic:build": "vite build apps/clinic --config apps/clinic/vite.config.ts",
    "clinic:typecheck": "tsc -p tsconfig.clinic.json",
    "clinic:api": "npm run foundation:build --silent && node .qualification-build/apps/clinic-server/src/index.js",
    "research:dev": "vite apps/research --config apps/research/vite.config.ts --host 127.0.0.1",
    "research:build": "vite build apps/research --config apps/research/vite.config.ts",
    "research:typecheck": "tsc -p tsconfig.research.json",
    "research:test": "vitest run --config apps/research/vitest.config.mts"
  },
  "dependencies": {
    "@convex-dev/auth": "0.0.96",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@workos-inc/authkit-nextjs": "^4.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.46.0",
    "convex-helpers": "0.1.128",
    "drizzle-orm": "^0.36.4",
    "lucide-react": "^0.468.0",
    "next": "^15.5.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.5.0",
    "ws": "8.22.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "@opennextjs/cloudflare": "^1.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "^3.0.0",
    "@vitest/ui": "^3.0.0",
    "convex-test": "0.0.61",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9",
    "eslint-config-next": "^15.5.12",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "6.4.2",
    "vitest": "^3.0.0",
    "wrangler": "^4.84.1"
  }
}
